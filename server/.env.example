# Copy this file to .env and fill in real values.

# Port the backend listens on
PORT=4000

# URL of your frontend (used for CORS and Stripe redirect URLs)
CLIENT_URL=http://localhost:5173

# Secret used to sign admin login tokens — set this to a long random string
JWT_SECRET=replace-with-a-long-random-string

# Stripe keys — get these from https://dashboard.stripe.com/apikeys
# Use TEST keys (start with sk_test_) while developing.
# Switch to LIVE keys (sk_live_) only when you're ready to accept real payments.
STRIPE_SECRET_KEY=sk_test_replace_me

# Get this after creating a webhook endpoint in the Stripe dashboard
# pointing to: https://your-backend-url.com/api/checkout/webhook
STRIPE_WEBHOOK_SECRET=whsec_replace_me
